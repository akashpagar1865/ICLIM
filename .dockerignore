# =====================================================
# Python Virtual Environment
# Docker creates its own isolated Python environment.
# Never copy the local virtual environment.
# =====================================================
.venv/
venv/

# =====================================================
# Git Metadata
# Version history is not required inside the image.
# =====================================================
.git/
.github/

# =====================================================
# VS Code Settings
# Editor-specific configuration used only during development.
# =====================================================
.vscode/

# =====================================================
# Python Cache Files
# Automatically regenerated by Python.
# Safe to exclude from the image.
# =====================================================
__pycache__/
*.pyc

# =====================================================
# Runtime Data
# Generated while the application is running.
# These should not be baked into the Docker image.
# In production these can later be mounted as Docker volumes.
# =====================================================
logs/
models/

# =====================================================
# Runtime Log Files
# Ignore any standalone log files created outside the logs/
# directory (for example: debug.log, app.log).
# The ICLIM logger already writes to logs/iclim.log, which is
# ignored by the logs/ rule above.
# =====================================================
*.log

# =====================================================
# CI/CD and Temporary Files
# Local artifacts that may be created while testing GitHub
# Actions or other automation workflows.
# =====================================================
.github/*.log

# =====================================================
# Archived / Inactive Code
# Old code kept only for reference.
# =====================================================
archive/