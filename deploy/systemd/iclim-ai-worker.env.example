# Copy to /etc/iclim-ai-worker.env, set the real key, then:
#   sudo chown root:root /etc/iclim-ai-worker.env && sudo chmod 600 /etc/iclim-ai-worker.env
# Never commit the real file.
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional overrides:
# GROQ_MODEL=openai/gpt-oss-20b
# PROMETHEUS_URL=http://localhost:9090
