# Prometheus Node Exporter (:9100). Binary: /usr/local/bin/node_exporter
# Runs as dedicated non-login user 'node_exporter'.
[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter

[Install]
WantedBy=multi-user.target
