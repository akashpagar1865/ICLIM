# Python cache
__pycache__/
*.pyc

# Virtual environment
.venv/

# VS Code settings (optional, your choice)
.vscode/

# Logs and generated data (we don’t need them in repo)
*.log
*.txt
# but keep this file tracked
!data/simulated_logs.txt
*.json
!requirements.txt

# Later we might keep an example JSON, but for now ignore all

#Remove models. These will be generated fresh once agent runs
models/*.pkl

#No need to save logs on repo
logs/
*.gz

# Terraform working directory
terraform/.terraform/

# Terraform state files
terraform/*.tfstate
terraform/*.tfstate.*

# Terraform crash logs
terraform/crash.log

# Terraform variable files (may contain secrets)
terraform/*.tfvars
terraform/*.tfvars.json

# Terraform plan files
terraform/*.tfplan

# SSH Keys
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
iclim_ed25519
iclim_ed25519.pub